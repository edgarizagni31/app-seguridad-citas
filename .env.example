# Copiar a .env y ajustar. Las variables EXPO_PUBLIC_* quedan en el bundle: nunca secretos.
EXPO_PUBLIC_API_URL=https://citascam.qas.ransaaplicaciones.com/api/
EXPO_PUBLIC_R360_API_URL=https://api-360v2.qas.ransaaplicaciones.com
# r360 | mock (mock prohibido en production)
EXPO_PUBLIC_AUTH_PROVIDER=r360
EXPO_PUBLIC_TIME_ZONE=America/El_Salvador
